{
	"permissions": {
		"deny": [
			"Read(.env)",
			"Read(.env.local)",
			"Read(.env.*.local)",
			"Read(.env.development)",
			"Read(.env.staging)",
			"Read(.env.production)",
			"Read(.env.test)",
			"Edit(.env)",
			"Edit(.env.local)",
			"Edit(.env.*.local)",
			"Edit(.env.development)",
			"Edit(.env.staging)",
			"Edit(.env.production)",
			"Edit(.env.test)"
		]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Read|Edit|Write|NotebookEdit|Grep|Glob|Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/deny-env-access.ts",
						"onFailure": "block"
					}
				]
			}
		]
	}
}
