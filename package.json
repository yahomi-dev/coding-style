{
	"name": "coding-style",
	"version": "1.0.0",
	"description": "",
	"type": "module",
	"scripts": {
		"build": "tsc",
		"check": "biome check .",
		"format": "biome check --write .",
		"lint": "biome lint .",
		"scan": "ast-grep scan",
		"wording:check": "node scripts/wording/check.ts",
		"md:check": "node scripts/markdown/check.ts",
		"md:format": "node scripts/markdown/check.ts --write",
		"typecheck:scripts": "tsc -p tsconfig.scripts.json",
		"test": "vitest run",
		"test:rules": "ast-grep test --skip-snapshot-tests",
		"prepare": "lefthook install"
	},
	"packageManager": "pnpm@10.14.0",
	"engines": {
		"node": ">=24.0.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@ast-grep/cli",
			"lefthook"
		]
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devDependencies": {
		"@ast-grep/cli": "^0.44.1",
		"@biomejs/biome": "^2.6.9",
		"@types/node": "^24.19.2",
		"lefthook": "^2.1.4",
		"ts-pattern": "^5.9.0",
		"typescript": "^5.9.3",
		"vitest": "^4.1.1",
		"zod": "^4.4.3"
	}
}
