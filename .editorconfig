root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = tab
trim_trailing_whitespace = true

# Markdown は行末の空白 2 つが改行を表すので、行末の空白を削除しない
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# YAML はタブを受け付けない
[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 2

[justfile]
indent_style = space
indent_size = 4
